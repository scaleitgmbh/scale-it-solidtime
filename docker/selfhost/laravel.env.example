APP_NAME="solidtime"
VITE_APP_NAME="solidtime"
APP_ENV="production"
APP_DEBUG="false"
APP_URL="http://localhost:8000"
APP_FORCE_HTTPS="false"
TRUSTED_PROXIES="0.0.0.0/0,2000:0:0:0:0:0:0:0/3"

# Authentication
# Generate these with:
#   docker compose run scheduler php artisan self-host:generate-keys
APP_KEY=""
PASSPORT_PRIVATE_KEY=""
PASSPORT_PUBLIC_KEY=""
SUPER_ADMINS=""

# Registration (disabled by default, create users via CLI instead)
APP_ENABLE_REGISTRATION="false"

# Logging
LOG_CHANNEL="stderr_daily"
LOG_LEVEL="debug"

# Database
DB_CONNECTION="pgsql"
DB_HOST="database"
DB_PORT="5432"
DB_SSLMODE="prefer"
DB_DATABASE="solidtime"
DB_USERNAME="solidtime"
DB_PASSWORD="randompassword"

# Mail (logs mail to storage/logs instead of sending, good enough for local use)
MAIL_MAILER="log"
MAIL_FROM_ADDRESS="no-reply@localhost"
MAIL_FROM_NAME="solidtime"

# Queue
QUEUE_CONNECTION="database"

# File storage
FILESYSTEM_DISK="local"
PUBLIC_FILESYSTEM_DISK="public"

# Services
GOTENBERG_URL="http://gotenberg:3000"
